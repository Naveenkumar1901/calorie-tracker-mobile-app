# Copy to .env and keep exactly one environment active.
# Restart with `npx expo start -c` after changing values.

# Development (local API). A physical phone cannot reach localhost,
# so use your PC's LAN IP (e.g. http://192.168.1.10:5000) when testing on a device.
# Android emulator: http://10.0.2.2:5000
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_BASE_URL=http://localhost:5000
EXPO_PUBLIC_SIGNALR_URL=http://localhost:5000/hubs

# Staging
# EXPO_PUBLIC_APP_ENV=staging
# EXPO_PUBLIC_API_BASE_URL=https://net/api
# EXPO_PUBLIC_SIGNALR_URL=https://net/api/hubs

# Production
# EXPO_PUBLIC_APP_ENV=production
# EXPO_PUBLIC_API_BASE_URL=https://net/api
# EXPO_PUBLIC_SIGNALR_URL=https://net/api/hubs
